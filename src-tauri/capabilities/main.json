{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege access for the NetMap main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-diagnostics",
    "allow-create-project",
    "allow-open-project",
    "allow-list-projects",
    "allow-preview-csv",
    "allow-import-csv",
    "allow-import-pcap",
    "allow-cancel-import",
    "allow-query-graph",
    "allow-delete-import",
    "allow-save-view",
    "allow-list-views",
    "allow-set-node-metadata",
    "allow-export-filtered-csv"
  ]
}
