{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetMap Portable",
  "version": "0.2.0",
  "identifier": "com.netmap.portable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "capabilities": ["main"]
    },
    "windows": [
      {
        "title": "NetMap Portable",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  }
}
